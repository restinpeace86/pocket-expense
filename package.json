{
  "name": "pocket-expense",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "next typegen",
    "db:migrate": "node scripts/supabase-sql.mjs --migrate",
    "test:db": "node scripts/supabase-sql.mjs --file supabase/tests/001_tenant_isolation.sql && node scripts/supabase-sql.mjs --file supabase/tests/002_onboarding_isolation.sql",
    "db:types": "node scripts/supabase-sql.mjs --types src/lib/supabase/database.types.ts",
    "bench:db": "node scripts/supabase-sql.mjs --file supabase/tests/bench_rls.sql",
    "check:responsive": "node scripts/check-responsive.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
