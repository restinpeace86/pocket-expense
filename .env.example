# PocketExpense 환경변수 목록 (값은 .env.local에만 넣고 커밋하지 않는다)

# 사이트
NEXT_PUBLIC_SITE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 (클라이언트 코드에서 사용 금지)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

# Google Gemini (영수증 파싱, 사내 양식 분석) — 서버 전용
GEMINI_API_KEY=
# (선택) 영수증 인식 모델. 비우면 gemini-flash-lite-latest, 재시도는 gemini-3.5-flash-lite (src/lib/receipts/gemini.ts)
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# 국세청 사업자등록 상태조회 (공공데이터포털, URL 인코딩된 일반 인증키) — 서버 전용 (D-057)
NTS_SERVICE_KEY=

# Kakao Local / Mobility (주소 검색, 자차 거리 계산) — 서버 전용
KAKAO_REST_API_KEY=

# 카카오 알림톡: log(기본, 실제 발송 없음) / 발송대행사 선정 후 드라이버 추가 (O-01)
ALIMTALK_DRIVER=log
# 실제 발송대행사 연결 시(⛔ O-01) — 드라이버 이름만 바꾸고 아래 값을 넣는다. 지금은 비워 두면 Mock(log)
ALIMTALK_API_KEY=
ALIMTALK_API_SECRET=
ALIMTALK_SENDER_KEY=
# 심사 통과한 템플릿 ID (ALIMTALK_TEMPLATE_<템플릿 코드>)
ALIMTALK_TEMPLATE_APPROVAL_REQUEST=
ALIMTALK_TEMPLATE_APPROVAL_COMPLETED=
ALIMTALK_TEMPLATE_APPROVAL_REJECTED=
ALIMTALK_TEMPLATE_PAYOUT_COMPLETED=
ALIMTALK_TEMPLATE_INVITE=
ALIMTALK_TEMPLATE_REMINDER=
ALIMTALK_TEMPLATE_RECURRING_READY=

# 무료 크레딧 이벤트 추가 지급 (D-054)
CREDIT_EVENT_BONUS_ENABLED=true
CREDIT_EVENT_BONUS_AMOUNT=100

# 하네스 알림
DISCORD_WEBHOOK_URL=

# 운영 보관함 정리 작업(Vercel Cron) 인증. 비우면 정리 작업이 동작하지 않는다 (src/app/api/cron/purge-receipt-archive)
CRON_SECRET=

# 카카오톡 공유(직원 초대). 카카오 개발자 콘솔 › 앱 키 › JavaScript 키. 플랫폼 › Web에 사이트 도메인 등록 필요. 비우면 공유 버튼이 숨겨진다
NEXT_PUBLIC_KAKAO_JS_KEY=
# 관리자 1:1 문의 카카오톡 채널 채팅 주소(예: https://pf.kakao.com/_abcde/chat). 비우면 문의 버튼을 숨긴다(D-127)
NEXT_PUBLIC_KAKAO_CHANNEL_CHAT_URL=
