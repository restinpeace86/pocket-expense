# PocketExpense 환경변수 목록 (값은 .env.local에만 넣고 커밋하지 않는다)

# 사이트
NEXT_PUBLIC_SITE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 (클라이언트 코드에서 사용 금지)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

# Google Gemini (영수증 파싱, 사내 양식 분석) — 서버 전용
GEMINI_API_KEY=
# (선택) 영수증 인식 모델. 비우면 gemini-flash-lite-latest, 재시도는 gemini-3.5-flash-lite (src/lib/receipts/gemini.ts)
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# 국세청 사업자등록 상태조회 (공공데이터포털, URL 인코딩된 일반 인증키) — 서버 전용 (D-057)
NTS_SERVICE_KEY=

# Kakao Local / Mobility (주소 검색, 자차 거리 계산) — 서버 전용
KAKAO_REST_API_KEY=

# 카카오 알림톡: log(기본, 실제 발송 없음) / 발송대행사 선정 후 드라이버 추가 (O-01)
ALIMTALK_DRIVER=log

# 무료 크레딧 이벤트 추가 지급 (D-054)
CREDIT_EVENT_BONUS_ENABLED=true
CREDIT_EVENT_BONUS_AMOUNT=100

# 하네스 알림
DISCORD_WEBHOOK_URL=

# 운영 보관함 정리 작업(Vercel Cron) 인증. 비우면 정리 작업이 동작하지 않는다 (src/app/api/cron/purge-receipt-archive)
CRON_SECRET=
