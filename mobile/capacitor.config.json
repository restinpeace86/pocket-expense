{
  "appId": "kr.damounlab.app",
  "appName": "RealOn",
  "webDir": "www",
  "server": {
    "url": "https://pocket-expense-ruby.vercel.app",
    "androidScheme": "https",
    "errorPath": "index.html"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#ffffff"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  },
  "backgroundColor": "#ffffff",
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#ffffff",
    "limitsNavigationsToAppBoundDomains": false
  }
}